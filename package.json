{
  "name": "mandate",
  "version": "0.1.0",
  "private": true,
  "description": "Mandate: people-set goals, market-advised decisions, on-chain enforcement (prototype)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "compile": "node scripts/compile.js",
    "build:app": "node scripts/build-app.js",
    "serve:app": "node scripts/serve-app.js",
    "deploy": "node scripts/deploy.js",
    "test": "node scripts/compile.js && node scripts/build-app.js && node --test --test-force-exit test/contracts.test.js test/attestor.e2e.test.js test/identity-vote.e2e.test.js test/app.e2e.test.js test/identity-service.test.js test/watchdog.test.js test/backup-code.test.mjs && python3 -m unittest discover -s test -p 'test_*.py'",
    "upload": "node broker/upload.js",
    "attestor": "node broker/attestor.js",
    "relayer": "node broker/relayer.js",
    "identity": "node services/identity/server.js",
    "watchdog": "node services/watchdog/server.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@semaphore-protocol/group": "4.14.5",
    "@semaphore-protocol/identity": "4.14.5",
    "@semaphore-protocol/proof": "4.14.5",
    "@walletconnect/ethereum-provider": "2.26.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.4",
    "form-data": "^4.0.1",
    "jose": "6.2.13",
    "jsqr": "1.4.0",
    "openid-client": "6.8.8",
    "poseidon-lite": "0.3.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.1.0",
    "@semaphore-protocol/contracts": "4.14.5",
    "@zk-kit/semaphore-artifacts": "4.13.0",
    "esbuild": "0.28.2",
    "ganache": "^7.9.2",
    "solc": "0.8.24"
  }
}
