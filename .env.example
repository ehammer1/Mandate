# --- oracle (AI verifier checks) ---
ANTHROPIC_API_KEY=
ORACLE_MODEL=claude-sonnet-5-5
ORACLE_EFFORT=medium
REDACTION_MAX_CONCURRENCY=4

# --- broker/upload.js (Pinata): JWT, or the legacy key pair ---
PINATA_JWT=
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# --- broker/attestor.js (verifier node) ---
RPC_URL=
VERIFIER_PRIVATE_KEY=
REGISTRY_ADDRESS=
START_BLOCK=
CONFIRMATIONS=3
IPFS_GATEWAY=https://gateway.pinata.cloud
PYTHON_BIN=python3
DRY_RUN=0

# --- broker/relayer.js (wallet-free ballot submission) ---
RELAYER_PRIVATE_KEY=
VOTE_ADDRESS=
PORT=8787
RATE_LIMIT_PER_MIN=30
CORS_ORIGIN=*
# Local Semaphore proving files for kiosks/tests (default: download on demand)
SEMAPHORE_ARTIFACTS_DIR=
